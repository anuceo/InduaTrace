{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrace.org/schema/artifact.json",
  "title": "IndusTrace Artifact",
  "description": "Physical archaeological object containing or associated with an inscription.",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "provenance"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "culture": {
      "type": [
        "string",
        "null"
      ]
    },
    "site": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "material": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimensions": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "length": {
          "type": [
            "number",
            "null"
          ]
        },
        "width": {
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "estimated_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
