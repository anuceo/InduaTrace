{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industrace.org/schema/inscription.json",
  "title": "IndusTrace Inscription",
  "description": "A documented inscription or inscription-bearing region of an artifact.",
  "type": "object",
  "required": [
    "inscription_id",
    "artifact_id"
  ],
  "properties": {
    "inscription_id": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "script_classification": {
      "type": [
        "string",
        "null"
      ]
    },
    "writing_direction": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "left_to_right",
        "right_to_left",
        "top_to_bottom",
        "bottom_to_top",
        "boustrophedon",
        "unknown",
        null
      ]
    },
    "sign_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
